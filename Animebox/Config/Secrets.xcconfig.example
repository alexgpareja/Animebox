// Secrets.xcconfig.example
// Plantilla — copia este fichero a Secrets.xcconfig (ignorado por git) y
// rellena tus propios client_id.
// MAL: registrado en myanimelist.net/apiconfig (tipo de app "iOS" → solo
// emite Client ID, sin secreto).
// AniList: registrado en anilist.co/settings/developer con Redirect URL =
// animebox://anilist-callback — Implicit Grant, tampoco hay secreto.

MAL_CLIENT_ID = tu-client-id-de-mal-aqui
ANILIST_CLIENT_ID = tu-client-id-de-anilist-aqui
